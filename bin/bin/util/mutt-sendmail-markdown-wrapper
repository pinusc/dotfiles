#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR

cleanup() {
  trap - SIGINT SIGTERM ERR
  # script cleanup here
  notify-send --urgency=critical "MAIL SEND FAILED"
}

tmpfile="$(mktemp --tmpdir mailmessage.XXXX)"

# mutt will pipe email text into 
~/bin/modules/add-html-to-email > "$tmpfile"

{
    # delay send by 5 minutes
    # so I can "undo-send" if necessary
    #sleep $(( 5 * 60 )) 

    if [[ -f "$tmpfile" ]]; then
      < "$tmpfile" msmtp "$@"
      notify-send "Mail sent successfully"
    else
      cleanup
    fi

    # rm "$tmpfile"
} &
